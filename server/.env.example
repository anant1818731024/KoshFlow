# ---------------------------------------------------------------------------
# KoshFlow API — environment
# Copy this file to `.env` and fill in your own values.
# ---------------------------------------------------------------------------

# Postgres connection string.
# Local Postgres example:
#   postgresql://postgres:postgres@localhost:5432/cachet?schema=public
#
# Neon (https://neon.tech) — use the POOLED connection string here:
#   postgresql://<user>:<password>@<endpoint>-pooler.<region>.aws.neon.tech/cachet?sslmode=require
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/cachet?schema=public"

# Neon only: a DIRECT (non-pooled) connection string, used for migrations.
# Leave it equal to DATABASE_URL for local Postgres.
#   postgresql://<user>:<password>@<endpoint>.<region>.aws.neon.tech/cachet?sslmode=require
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/cachet?schema=public"

# API server port
PORT=4000

# Allowed browser origin for CORS (your Vite dev server).
CLIENT_ORIGIN="http://localhost:5173"
